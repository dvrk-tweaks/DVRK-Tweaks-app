<Window x:Class="DvrkTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DVRK Tweaks — Ultimate"
        Width="1450"
        Height="900"
        MinWidth="1100"
        MinHeight="720"
        Background="{StaticResource BG}"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="#0C0D12"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,1,0">

            <DockPanel>

                <!-- TOP BRANDING -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="22,24,22,15">

                    <TextBlock Text="DVRK"
                               FontSize="35"
                               FontWeight="Bold"
                               Foreground="{StaticResource Text}"/>

                    <TextBlock Text="TWEAKS"
                               FontSize="12"
                               Foreground="{StaticResource Purple}"
                               FontWeight="Bold"/>

                    <Border Background="{StaticResource Panel}"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,18,0,0">

                        <StackPanel>

                            <TextBlock Text="SYSTEM STATUS"
                                       FontSize="9"
                                       Foreground="{StaticResource Muted}"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="SystemStatus"
                                       Text="● READY"
                                       FontSize="12"
                                       Foreground="{StaticResource Green}"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>


                <!-- NAVIGATION -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel x:Name="NavPanel"
                                Margin="10,0,10,10"/>

                </ScrollViewer>


                <!-- DISCORD -->
                <Border DockPanel.Dock="Bottom"
                        Background="#17121F"
                        Padding="12"
                        Margin="12">

                    <StackPanel>

                        <TextBlock Text="DVRK COMMUNITY"
                                   FontSize="9"
                                   Foreground="{StaticResource Muted}"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Updates, releases &amp; support."
                                   FontSize="11"
                                   Foreground="{StaticResource Text}"
                                   Margin="0,5,0,8"/>

                        <Button Content="JOIN DISCORD"
                                Style="{StaticResource Primary}"
                                Click="Discord_Click"/>

                    </StackPanel>

                </Border>

            </DockPanel>

        </Border>


        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1"
              Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->
            <Grid Grid.Row="0">

                <StackPanel>

                    <TextBlock Text="DVRK TWEAKS"
                               FontSize="13"
                               Foreground="{StaticResource Purple}"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="TitleText"
                               Text="FPS &amp; Graphics"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text}"
                               Margin="0,4,0,0"/>

                    <TextBlock x:Name="SubtitleText"
                               Foreground="{StaticResource Muted}"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="DISCORD"
                            Style="{StaticResource Ghost}"
                            Click="Discord_Click"
                            Margin="0,0,8,0"/>

                    <Button Content="APPLY ENABLED"
                            Style="{StaticResource Primary}"
                            Click="ApplyAll_Click"/>

                    <Button Content="RESET PROFILE"
                            Style="{StaticResource Ghost}"
                            Click="Reset_Click"
                            Margin="8,0,0,0"/>

                </StackPanel>

            </Grid>


            <!-- STATS -->
            <Grid Grid.Row="1"
                  Margin="0,25,0,14">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>


                <!-- SEARCH -->
                <Border Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="13">

                    <TextBox x:Name="SearchBox"
                             TextChanged="SearchBox_TextChanged"
                             Background="Transparent"
                             Foreground="{StaticResource Text}"
                             BorderThickness="0"
                             FontSize="14"/>

                </Border>


                <!-- SWITCH COUNT -->
                <Border Grid.Column="1"
                        Background="{StaticResource Panel}"
                        CornerRadius="12"
                        Margin="10,0,0,0"
                        Padding="14">

                    <StackPanel>

                        <TextBlock Text="SWITCHES"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="9"/>

                        <TextBlock x:Name="SwitchCount"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}"/>

                    </StackPanel>

                </Border>


                <!-- ENABLED COUNT -->
                <Border Grid.Column="2"
                        Background="{StaticResource Panel}"
                        CornerRadius="12"
                        Margin="10,0,0,0"
                        Padding="14">

                    <StackPanel>

                        <TextBlock Text="ENABLED"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="9"/>

                        <TextBlock x:Name="EnabledCount"
                                   Text="0"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}"/>

                    </StackPanel>

                </Border>


                <!-- PROFILE -->
                <Border Grid.Column="3"
                        Background="{StaticResource Panel}"
                        CornerRadius="12"
                        Margin="10,0,0,0"
                        Padding="14">

                    <StackPanel>

                        <TextBlock Text="PROFILE"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="9"/>

                        <TextBlock x:Name="StatusText"
                                   Text="READY"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- PERFORMANCE PROFILE -->
            <Border Grid.Row="2"
                    Background="#14101B"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,14">

                <DockPanel>

                    <StackPanel>

                        <TextBlock Text="⚡ DVRK PERFORMANCE PROFILE"
                                   Foreground="{StaticResource Text}"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Every item represents an actual configurable Windows or application setting."
                                   Foreground="{StaticResource Muted}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                    <TextBlock DockPanel.Dock="Right"
                               Text="180+ PERFORMANCE SWITCHES"
                               Foreground="{StaticResource Purple}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>

                </DockPanel>

            </Border>


            <!-- TWEAK LIST -->
            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl x:Name="TweaksList">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Background="{StaticResource Panel}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="13"
                                    Padding="18"
                                    Margin="0,0,10,10">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <!-- TWEAK INFORMATION -->
                                    <StackPanel>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text}"/>

                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{StaticResource Muted}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,20,0"/>

                                    </StackPanel>


                                    <!-- TOGGLE -->
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Checked="Tweak_Checked"
                                              Unchecked="Tweak_Unchecked"
                                              Style="{StaticResource Toggle}"
                                              VerticalAlignment="Center"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>


            <!-- FOOTER -->
            <DockPanel Grid.Row="4"
                       Margin="0,12,10,0">

                <TextBlock Text="DVRK Tweaks • Ultimate Edition"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"/>

                <TextBlock x:Name="AdminText"
                           DockPanel.Dock="Right"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"/>

            </DockPanel>

        </Grid>

    </Grid>

</Window>